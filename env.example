# This file contains environment variables that your application needs to run.
# It's used to document the required variables and provide example values.
# DO NOT commit your actual .env file with sensitive information to version control.

# Database connection string for Prisma. Replace with your actual PostgreSQL connection string.
# Example: postgresql://user:password@localhost:5432/mydatabase?schema=public
DATABASE_URL=""

# A secret key used by NextAuth.js for signing and encrypting session tokens.
# Generate a strong, random string for this. You can use `openssl rand -base64 32`.
NEXTAUTH_SECRET=""
