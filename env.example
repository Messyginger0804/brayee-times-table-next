# Environment variables read by Braylee's Mission Control.
# Copy the ones you need into the right file (see docs/DEVELOPMENT.md, "Env files"):
#   .env.docker  - used by `docker compose` (app service) and by `npm run dev:local`
#   .env.local   - used by plain `npm run dev` / `next start` (Next.js loads it)
#   .env         - also read by the Prisma CLI (prisma migrate / db seed)
# All of these files are gitignored. Never commit real values. Values below are blank or fake.

# ---------------------------------------------------------------------------
# Core (required in every environment)
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma (prisma/schema.prisma) and the maintenance scripts.
# Required: dev, docker, prod. No default.
# With docker compose the db service listens on host port 55436. Inside the app container the host is `db`
# (postgresql://braylee:...@db:5432/braylee); `npm run dev:local` rewrites `@db:5432` to `@localhost:55436` itself.
DATABASE_URL=""

# Secret that signs and encrypts the NextAuth JWT session cookie, and is checked by middleware.js.
# Required: dev, docker, prod. No default. Generate with: openssl rand -base64 32
# Changing it signs everyone out AND invalidates every student ID: they are hashed with a pepper derived from this secret (lib/pinAuth.js).
NEXTAUTH_SECRET=""

# Public base URL of the app, read by NextAuth (not referenced directly in app code).
# Optional on Vercel (derived from the deployment). Set it for docker/local, e.g. http://localhost:3200.
# `npm run dev:local` sets it to http://localhost:3300 for you.
NEXTAUTH_URL=""

# ---------------------------------------------------------------------------
# Seeding (prisma/seed-users.js, run by `npm run db:seed` and by the docker entrypoint)
# ---------------------------------------------------------------------------

# Student ID for the one pre-existing real account, Braylee. Optional. Must be exactly 7 digits (0-9 only) or the seed fails.
# Default: unset -> a random ID is generated and printed once, only when the user row is first created.
# Applies only when the user does not exist yet; re-running the seed never changes an existing ID.
# Used in: dev, docker, any fresh database.
SEED_BRAYLEE_PIN=""

# ---------------------------------------------------------------------------
# Guest seats (lib/guests.js)
# ---------------------------------------------------------------------------

# Number of guest seats (Guest 001, 002, ...). Optional. Default 5, clamped to 1-100.
# Lowering it later leaves higher seats unreachable (they are still purged after 7 idle days).
GUEST_SEATS=5

# Minutes a taken guest seat must sit idle before a NEW device may take it over (its progress is wiped).
# Optional. Default 15. If every seat is taken and none is idle that long, new guests see "All seats are busy".
GUEST_MIN_IDLE_MINUTES=15

# Saved cadets: a guest can keep their cadet (nickname + student ID of exactly 7 digits, progress kept). Max number of saved cadets, not counting Braylee.
# Optional: default 10, clamped 0-500. When full, "Save my cadet" says the spots are taken and the kid keeps playing as a guest.
SAVED_CADETS_MAX=10

# Days without activity (User.lastActiveAt) before a saved cadet is deleted with all their data. Optional: default 30, clamped 1-3650.
# Runs lazily (sign-in, saves, saved-cadet requests) and in the daily cron. Braylee is never purged.
SAVED_CADET_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Production only
# ---------------------------------------------------------------------------

# Shared secret for the daily guest purge (GET /api/cron/purge-guests, scheduled in vercel.json).
# Vercel sends it as `Authorization: Bearer $CRON_SECRET`. Generate with: openssl rand -base64 32
# Optional locally: when unset the endpoint answers 401 to every request. Required in prod for the purge to run.
CRON_SECRET=""

# Set by Vercel ("production" / "preview" / "development"), not by you. lib/pinAuth.js only upgrades legacy student-ID hashes to the
# peppered format on sign-in when this is "production", so previews and laptops pointed at the prod DB can never rewrite Braylee's hash.
# VERCEL_ENV=

# Production hostname without scheme (Vercel sets this automatically). Used by app/layout.jsx to build metadataBase
# (link previews, Open Graph image URLs). Do not set it by hand; a built-in fallback URL is used when it is missing.
# VERCEL_PROJECT_PRODUCTION_URL=

# ---------------------------------------------------------------------------
# Tests and tooling (optional, never set in prod)
# ---------------------------------------------------------------------------

# Local, migrated Postgres for the real-database concurrency test tests/guestWrite.pg.test.js.
# Optional. Skipped when unset (CI has no database). DATABASE_URL must point at the same database when you run it.
# Must be a LOCAL database; the test writes rows.
# TEST_DATABASE_URL=""

# Path to a Chrome/Chromium binary for scripts/build-icons.mjs (icon rendering). Optional: when unset the script looks in Playwright's cache (~/.cache/ms-playwright) and errors if none is found.
# CHROME=""

# Set to 1 to let a non-production process upgrade legacy student-ID hashes to the peppered format on sign-in (lib/pinAuth.js).
# Local testing only; never set it against the prod database.
# PIN_REHASH=

# NODE_ENV is set by Next.js / the Dockerfile, not by you. It is read for: hiding /gifs in production (app/gifs/page.jsx),
# the Secure flag on the guest cookie (lib/guests.js), and dev-only behavior in lib/momentDirector.js and lib/prisma.js
# (dev warnings; Prisma client reuse across hot reloads).
