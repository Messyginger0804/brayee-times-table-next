generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The 144 times-table facts (1-12 x 1-12), shared by all players. correct/incorrect are global counters across players.
model Problem {
  id           Int           @id @default(autoincrement())
  problem      String
  answer       Int
  correct      Int           @default(0)
  incorrect    Int           @default(0)
  mastered     Boolean       @default(false)
  attempts     Attempt[]
  userProblems UserProblem[]
}

model Attempt {
  id        Int      @id @default(autoincrement())
  problemId Int
  userId    Int?
  isCorrect Boolean
  createdAt DateTime @default(now())

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@index([problemId, createdAt])
  @@index([userId, problemId, createdAt])
}

model UserProblem {
  userId      Int
  problemId   Int
  everCorrect Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  // Mastery rule (see lib/mastery.js): 3 correct in a row => true; any miss clears it.
  mastered    Boolean  @default(false)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@id([userId, problemId])
  @@index([userId, problemId])
}

model User {
  id                  Int                 @id @default(autoincrement())
  name                String              @unique
  // bcrypt hash of the student ID, 5-8 digits (HMAC-peppered since saved cadets; legacy rows may still hold plain bcrypt or plaintext until their next login). null for guest seats.
  pin                 String?
  image               String?
  // Times-table level (1 or 2), not a per-skill level.
  level               Int                 @default(1)
  createdAt           DateTime            @default(now())
  // Login lockout (lib/pinAuth.js): consecutive wrong student IDs 5-9 => lockedUntil = now + 1 min, 10-14 => 5 min, 15-19 => 30 min,
  // 20-24 => 2 h, 25+ => 24 h. Both are reset on a correct student ID.
  failedLoginAttempts Int                 @default(0)
  lockedUntil         DateTime?
  // Unused since the parent screens were removed (kept: additive-only policy)
  isAdmin             Boolean             @default(false)
  // School grade 1-6 (null = not set). Chosen by the kid via PUT /api/me/grade; drives grade-aware spelling + math.
  grade               Int?
  // Guest seats (Guest 001-005): anonymous players, no PIN. Access is only via a random secret in an httpOnly cookie;
  // guestTokenHash is its sha256. null hash = the seat is free. lastActiveAt drives the 7-day idle wipe (lib/guests.js).
  isGuest             Boolean             @default(false)
  guestSeat           Int?                @unique
  guestTokenHash      String?             @unique
  lastActiveAt        DateTime?
  // Saved cadets (lib/savedCadets.js): a guest seat converted into a named account. `name` is the nickname, `pin` the bcrypt hash of the
  // student ID (5-8 digits). Not a guest any more (isGuest false, no seat, no token). Wiped after SAVED_CADET_RETENTION_DAYS without lastActiveAt.
  savedCadet          Boolean             @default(false)
  savedAt             DateTime?
  mathProgress        MathSkillProgress[]
  mathAttempts        MathAttempt[]
  spellingAttempts    SpellingAttempt[]
  tests               Test[]
  attempts            Attempt[]
  userProblems        UserProblem[]
  skillUnlocks        SkillUnlock[]
  // NextAuth optional fields
  email               String?             @unique
  emailVerified       DateTime?
  accounts            Account[]
  sessions            Session[]
}

// Written only by POST /api/test/score, which the UI does not call (Testing mode saves no score). Effectively unused.
model Test {
  id        Int      @id @default(autoincrement())
  score     Int
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}

// NextAuth models
model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SpellingWord {
  id           Int      @id @default(autoincrement())
  word         String   @unique
  definition   String
  partOfSpeech String
  sentence     String
  difficulty   Int      @default(1)
  category     String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // Curriculum metadata (all nullable; legacy rows are filled by scripts/import-spelling.js)
  grade        Int?
  unitId       String?
  tier         String? // core | hf | bee
  syllables    Int?
  source       String? // original | legacy

  attempts SpellingAttempt[]

  @@index([active])
  @@index([category])
  @@index([difficulty])
  @@index([grade, tier])
  @@index([grade, unitId])
}

// Nothing in the app writes this table (Spelling Bee results are not saved). Rows are still wiped with a guest seat.
model SpellingAttempt {
  id        Int      @id @default(autoincrement())
  userId    Int
  wordId    Int
  isCorrect Boolean
  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  word SpellingWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([userId, wordId])
}

// Per-kid progress for generated (non-Problem-row) math skills. skillId matches docs/curriculum/math.json.
// Times-table skills that map onto Problem rows keep using UserProblem/Attempt, not this table.
model MathSkillProgress {
  id         Int       @id @default(autoincrement())
  userId     Int
  skillId    String
  levelIndex Int       @default(0) // 0-based index into the skill's levels[]
  // Last-N window for the CURRENT level: [{ c: boolean, ms: number }], oldest first, capped at 20
  recent     Json      @default("[]")
  attempts   Int       @default(0)
  correct    Int       @default(0)
  mastered   Boolean   @default(false)
  masteredAt DateTime?
  // Legacy: was set from the removed /parent screen. Kept (additive-only policy), no longer read or written.
  unlockedByParent Boolean @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
}

model MathAttempt {
  id         Int      @id @default(autoincrement())
  userId     Int
  skillId    String
  levelIndex Int      @default(0)
  prompt     String
  expected   String
  given      String
  correct    Boolean
  ms         Int
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, skillId, createdAt])
}

// Missions (skills) a kid has unlocked. Permanent: an unlock is never removed (only a progress wipe clears it), so a later miss on a
// fact shared with the previous skill cannot lock the mission again. Written idempotently by lib/skillState.js.
model SkillUnlock {
  id         Int      @id @default(autoincrement())
  userId     Int
  skillId    String
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}
